{
    "name": "ernestdefoe/skylight",
    "description": "Skylight: a calm glass-and-daylight theme for Flarum 2, with a Studio where each member picks their own accent, background, glass, text size and list view.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "flarum-extension",
        "theme",
        "glass",
        "glassmorphism",
        "personalization",
        "dark-mode",
        "accessibility"
    ],
    "homepage": "https://github.com/ernestdefoe/skylight",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Inside a tag, the page takes the tag's color, and cards show it along their top edge.",
        "ernestdefoe/wardrobe": "Offer Skylight beside other themes, chosen by each member and guest.",
        "ernestdefoe/bespoke": "Skylight stays off while Bespoke styles the forum, unless Wardrobe lets each member pick their theme.",
        "fof/discussion-views": "Skylight shows its view count beside the reply count in every list view.",
        "flarum/sticky": "Sticky discussions' excerpts in the list use Skylight's cleaner text.",
        "fof/discussion-thumbnail": "Cards can show each discussion's thumbnail image, at a size the admin picks."
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Skylight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Skylight\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Skylight",
            "category": "theme",
            "icon": {
                "name": "fas fa-sun",
                "backgroundColor": "#127C86",
                "color": "#FFF6E8"
            },
            "optional-dependencies": [
                "flarum/tags",
                "ernestdefoe/wardrobe",
                "ernestdefoe/bespoke",
                "fof/discussion-views",
                "flarum/sticky",
                "fof/discussion-thumbnail"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/ernestdefoe/skylight/issues",
        "source": "https://github.com/ernestdefoe/skylight"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0",
        "laravel/pint": "^1.32"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "style": "pint --test",
        "style:fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    }
}
